{
  "name": "salati-tunisia",
  "productName": "Salati Tunisia",
  "version": "1.0.1",
  "description": "Salati Tunisia — صلاتي تونس. Desktop prayer-times widget for Tunisian cities.",
  "main": "dist-electron/main.js",
  "private": true,
  "author": {
    "name": "Salati Tunisia",
    "email": "salati@example.com"
  },
  "license": "MIT",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev:renderer": "vite",
    "build": "npm run typecheck && npm run build:electron && vite build",
    "build:electron": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --external:electron --external:electron-store --external:electron-updater --outdir=dist-electron",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "electron .",
    "icons": "node scripts/make-icons.js",
    "dist": "npm run build && npm run icons && electron-builder --win",
    "dist:dir": "npm run build && npm run icons && electron-builder --win --dir",
    "release": "npm run build && npm run icons && electron-builder --win --publish onTag"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.11",
    "lottie-react": "^3.1.2",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^45.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.4",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "tn.salati.tunisia",
    "productName": "Salati Tunisia",
    "publish": {
      "provider": "github",
      "owner": "mohamedamine-code",
      "repo": "prayer_TN"
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Salati Tunisia",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
